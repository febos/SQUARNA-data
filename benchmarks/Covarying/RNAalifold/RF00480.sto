#=GF TP   Cis-reg; frameshift_element;
#=GF BM   cmbuild -F CM SEED
#=GF CB   cmcalibrate --mpi CM
#=GF SM   cmsearch --cpu 4 --verbose --nohmmonly -E 1000 -Z 549862.597050 CM SEQDB
#=GF DR   SO; 0000233; mature_transcript;
#=GF DR   GO; 0075523; viral translational frameshifting;
#=GF RN   [1]
#=GF RM   14747573
#=GF RT   The human immunodeficiency virus type 1 ribosomal frameshifting site is an
#=GF RT   invariant sequence determinant and an important target for antiviral
#=GF RT   therapy.
#=GF RA   Biswas P, Jiang X, Pacchia AL, Dougherty JP, Peltz SW
#=GF RL   J Virol 2004;78:2082-2087.
#=GF CC   This family represents the HIV Ribosomal frameshift signal. HIV uses a
#=GF CC   system called -1 ribosomal frameshifting to produce the required ratio of
#=GF CC   Gag and Gag-Pol polyproteins. The stem-loop structure of the frameshift
#=GF CC   signal is thought to impede the ribosome and cause slippage in the 5'
#=GF CC   direction, this causes the -1 frameshift and translation then continues in
#=GF CC   the new frame [1].
#=GF WK   HIV_ribosomal_frameshift_signal
#=GF SQ   145

